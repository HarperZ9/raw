// RawPhysicsKernels.bld: RAW Engine Deterministic Scalar Physics Reference Kernels in BuildLang.
// Canonical BuildLang 1.4.0 counterparts to RAW Engine's C++23 and HLSL SM 6.6/6.10 physics kernels:
//   1. wind_chill_c         - Osczevski-Bluestein wind-chill index (rt_stealth_survival.cpp)
//   2. phase_hg             - Henyey-Greenstein Mie scattering phase function (AtmosphereLut / Clouds / LightFog)
//   3. beer_lambert         - Beer-Lambert spectral transmittance (RtWater / RawMaterials3D / RawCosmosSky)
//   4. davinci_pipe_radius  - Leonardian da Vinci botanical pipe-model radius (RawFloraEngine.cpp)
//   5. xpbd_lambda_delta    - XPBD compliance Lagrange multiplier update (RawXpbdClothSim.hlsl)
//   6. crafting_cap_mult    - Hyperbolic-tangent crafting anti-exploit asymptote (rt_progression_economy.cpp)
// Original work, MIT.

fn clamp_f64(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo {
        lo
    } else if v > hi {
        hi
    } else {
        v
    }
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

// 1. Osczevski-Bluestein (Environment Canada / NOAA) wind-chill temperature in Celsius.
// Matches src/engine_rt/rt_stealth_survival.cpp (lines 114-120).
fn wind_chill_c(air_c: f64, wind_kmh: f64) -> f64 {
    let mut wc: f64 = air_c;
    if air_c <= 10.0 && wind_kmh >= 4.8 {
        let w_pow: f64 = pow(wind_kmh, 0.16);
        wc = 13.12 + 0.6215 * air_c - 11.37 * w_pow + 0.3965 * air_c * w_pow;
    }
    clamp_f64(wc, -45.0, 40.0)
}

// 2. Henyey-Greenstein Mie scattering phase function P(cos_theta, g).
// Matches src/d3d12_bridge/shaders/AtmosphereLut.hlsl, Clouds.hlsl, and LightFog.hlsl.
fn phase_hg(cos_theta: f64, g: f64) -> f64 {
    let pi_val: f64 = 3.14159265358979323846;
    let gc: f64 = clamp_f64(g, -0.98, 0.98);
    let mu: f64 = clamp_f64(cos_theta, -1.0, 1.0);
    let g2: f64 = gc * gc;
    let denom_base: f64 = max_f64(1.0 + g2 - 2.0 * gc * mu, 1.0e-6);
    let denom: f64 = denom_base * sqrt(denom_base);
    (1.0 - g2) / (4.0 * pi_val * denom)
}

// 3. Beer-Lambert spectral optical transmittance T = exp(-sigma_t * dist).
// Matches src/d3d12_bridge/shaders/RtWater.hlsl, RawMaterials3D.hlsli, and RawCosmosSky.hlsli.
fn beer_lambert(sigma_t: f64, dist: f64) -> f64 {
    let od: f64 = max_f64(sigma_t, 0.0) * max_f64(dist, 0.0);
    exp(-od)
}

// 4. Leonardian da Vinci botanical pipe-model parent branch radius:
//    r_parent = (r_a^p + r_b^p)^(1 / p), with p clamped to [1.8, 3.5] (2.5 default).
// Matches src/worldgen/RawFloraEngine.cpp (lines 650-684).
fn davinci_pipe_radius(r_child_a: f64, r_child_b: f64, exponent_p: f64) -> f64 {
    let p: f64 = clamp_f64(exponent_p, 1.8, 3.5);
    let ra: f64 = max_f64(r_child_a, 0.0);
    let rb: f64 = max_f64(r_child_b, 0.0);
    let sum_pow: f64 = pow(ra, p) + pow(rb, p);
    if sum_pow <= 1.0e-12 {
        0.0
    } else {
        pow(sum_pow, 1.0 / p)
    }
}

// 5. XPBD (Macklin et al. 2016) compliance-regularized Lagrange multiplier increment:
//    alpha_tilde = compliance / (sub_dt^2)
//    delta_lambda = (-C - alpha_tilde * lambda_prev) / (inv_mass_sum + alpha_tilde)
// Matches src/d3d12_bridge/shaders/RawXpbdClothSim.hlsl (lines 308-334).
fn xpbd_lambda_delta(c_val: f64, lambda_prev: f64, inv_mass_sum: f64, compliance: f64, sub_dt: f64) -> f64 {
    let dt_safe: f64 = max_f64(sub_dt, 1.0e-5);
    let alpha_tilde: f64 = max_f64(compliance, 0.0) / (dt_safe * dt_safe);
    let denom: f64 = max_f64(inv_mass_sum, 0.0) + alpha_tilde;
    if denom <= 1.0e-12 {
        0.0
    } else {
        (-c_val - alpha_tilde * lambda_prev) / denom
    }
}

// 6. Smooth strictly-monotonic hyperbolic-tangent crafting anti-exploit multiplier:
//    span = clamp(max_cap, 1.25, 2.25) - 1.0
//    raw_gain = w * (0.12 + 0.88 * (skill / 100)) + fortify_frac
//    effective_mult = 1.0 + span * tanh(raw_gain / span)  (strictly < max_cap <= 2.25x)
// Matches src/engine_rt/rt_progression_economy.cpp (EvaluateCraftingCaps, lines 132-150).
fn crafting_cap_mult(skill_0_100: f64, fortify_frac: f64, skill_weight: f64, max_cap: f64) -> f64 {
    let skill: f64 = clamp_f64(skill_0_100, 0.0, 100.0);
    let fort: f64 = max_f64(fortify_frac, 0.0);
    let w: f64 = clamp_f64(skill_weight, 0.1, 2.0);
    let cap: f64 = clamp_f64(max_cap, 1.25, 2.25);
    let span: f64 = max_f64(cap - 1.0, 1.0e-4);
    let raw_gain: f64 = w * (0.12 + 0.88 * (skill / 100.0)) + fort;
    1.0 + span * tanh(raw_gain / span)
}

fn main() ~ Console {
    let wc_blizzard: f64 = wind_chill_c(-10.0, 36.0);
    let hg_fwd: f64 = phase_hg(0.95, 0.72);
    let hg_back: f64 = phase_hg(-0.95, 0.72);
    let bl_ice_blue: f64 = beer_lambert(0.045, 2.0);
    let pipe_r: f64 = davinci_pipe_radius(0.30, 0.30, 2.5);
    let d_lambda: f64 = xpbd_lambda_delta(0.02, 0.0, 2.0, 1.0e-6, 0.0041666667);
    let craft_master: f64 = crafting_cap_mult(100.0, 0.50, 0.85, 2.25);
    let craft_exploit: f64 = crafting_cap_mult(100.0, 100.0, 2.0, 2.25);

    println!("wind_chill_c(-10C, 36km/h) = {}", wc_blizzard);
    println!("phase_hg(0.95, 0.72) = {} | phase_hg(-0.95, 0.72) = {}", hg_fwd, hg_back);
    println!("beer_lambert(0.045, 2.0) = {}", bl_ice_blue);
    println!("davinci_pipe_radius(0.30, 0.30, 2.5) = {}", pipe_r);
    println!("xpbd_lambda_delta(0.02, 0, 2.0, 1e-6, dt/4) = {}", d_lambda);
    println!("crafting_cap_mult(100, 0.50) = {} | exploit(100, 100.0) = {}", craft_master, craft_exploit);
}
